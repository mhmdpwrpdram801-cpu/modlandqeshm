  "checks": [
    {
      "t": "bot_events",
      "c": "bot_events_event_known",
      "d": "CHECK ((event = ANY (ARRAY['start'::text, 'browse'::text, 'view'::text, 'media'::text, 'cart_add'::text, 'checkout'::text, 'order'::text, 'pay_click'::text, 'receipt'::text, 'paid'::text, 'ask'::text])))"
    },
    {
      "t": "expenses",
      "c": "expenses_amount_check",
      "d": "CHECK ((amount > (0)::numeric))"
    },
    {
      "t": "invoice_items",
      "c": "invoice_items_line_matches",
      "d": "CHECK ((COALESCE(line_total, (0)::numeric) = ((quantity)::numeric * COALESCE(unit_price, (0)::numeric))))"
    },
    {
      "t": "invoice_items",
      "c": "invoice_items_price_nonneg",
      "d": "CHECK ((COALESCE(unit_price, (0)::numeric) >= (0)::numeric))"
    },
    {
      "t": "invoice_items",
      "c": "invoice_items_qty_positive",
      "d": "CHECK ((quantity > 0))"
    },
    {
      "t": "invoices",
      "c": "invoices_amounts_nonneg",
      "d": "CHECK (((COALESCE(items_total, (0)::numeric) >= (0)::numeric) AND (COALESCE(discount, (0)::numeric) >= (0)::numeric) AND (COALESCE(total_amount, (0)::numeric) >= (0)::numeric) AND (COALESCE(paid_amount, (0)::numeric) >= (0)::numeric)))"
    },
    {
      "t": "invoices",
      "c": "invoices_discount_not_over_items",
      "d": "CHECK ((COALESCE(discount, (0)::numeric) <= COALESCE(items_total, (0)::numeric)))"
    },
    {
      "t": "invoices",
      "c": "invoices_total_matches",
      "d": "CHECK ((COALESCE(total_amount, (0)::numeric) = (COALESCE(items_total, (0)::numeric) - COALESCE(discount, (0)::numeric))))"
    },
    {
      "t": "payments",
      "c": "payments_amount_positive",
      "d": "CHECK ((amount > (0)::numeric))"
    },
    {
      "t": "products",
      "c": "products_price_nonneg",
      "d": "CHECK ((COALESCE(price, (0)::numeric) >= (0)::numeric))"
    },
    {
      "t": "returns",
      "c": "returns_value_nonneg",
      "d": "CHECK ((COALESCE(total_value, (0)::numeric) >= (0)::numeric))"
    },
    {
      "t": "salaries",
      "c": "salaries_amount_check",
      "d": "CHECK ((amount > (0)::numeric))"
    },
    {
      "t": "telegram_orders",
      "c": "telegram_orders_total_nonneg",
      "d": "CHECK ((COALESCE(total, (0)::numeric) >= (0)::numeric))"
    }
  ],
