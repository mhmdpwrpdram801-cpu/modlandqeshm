  "checks": [
    {
      "name": "خواندنِ ۸۵۰٬۰۰۰ به سه شکل",
      "js": "()=>[parseNum('850.000'),parseNum('۸۵۰٬۰۰۰'),parseNum('850,000')].join('/')",
      "expect": "850000/850000/850000"
    },
    {
      "name": "جمعِ ۳×۸۵۰٬۰۰۰ با تخفیفِ ۵۰٬۰۰۰",
      "before": "nav('new'); document.getElementById('itemsWrap').innerHTML=''; addItemRow(); (()=>{const r=document.querySelector('.itemrow'),s=r.querySelector('.ir-prod'); s.value='p1'; onPickProduct(s); r.querySelector('.ir-qty').value='۳'; document.getElementById('nDiscMode').value='t'; document.getElementById('nDiscount').value='50,000'; recalc();})()",
      "js": "()=>document.getElementById('tItems').textContent+'|'+document.getElementById('tFinal').textContent",
      "expect": "۲٬۵۵۰٬۰۰۰|۲٬۵۰۰٬۰۰۰"
    },
    {
      "name": "تخفیفِ درصدی ۱۰٪",
      "before": "document.getElementById('nDiscMode').value='p'; document.getElementById('nDiscount').value='۱۰'; recalc()",
      "js": "()=>document.getElementById('tFinal').textContent",
      "expect": "۲٬۲۹۵٬۰۰۰"
    },
    {
      "name": "ماندهٔ فاکتور با پرداختِ بعدی",
      "before": "openInvoiceById('i1')",
      "wait": 900,
      "js": "()=>/۱٬۱۰۰٬۰۰۰/.test((document.getElementById('invPayInfo')||{}).textContent||'')",
      "expect": "True"
    },
    {
      "name": "پرداخت روی فاکتورِ باطل مسدود است",
      "before": "openInvoiceById('i3')",
      "wait": 800,
      "js": "()=>(document.getElementById('payInvBtn')||{}).style.display",
      "expect": "none"
    },
    {
      "name": "کتابخانهٔ سنگین در شروع بار نمی‌شود",
      "js": "()=>typeof window.html2canvas",
      "expect": "undefined"
    },
    {
      "name": "فرمِ کالا از هر صفحه‌ای دیده می‌شود",
      "before": "nav('dashboard'); openProductForm('p1')",
      "wait": 500,
      "js": "()=>{const w=document.getElementById('prodFormWrap'),r=w.getBoundingClientRect();return (!w.classList.contains('hidden')&&r.width>0&&r.height>0)?'دیده می‌شود':'نامرئی'}",
      "expect": "دیده می‌شود"
    }
  ],
  "click_test": {
    "selector": "#scr-dashboard .dash-btn",
    "before": "nav('dashboard')",
    "wait": 600,
    "settle": 450
  }
}